# ──────────────────────────────────────────────────────────────────────────────
# Antonela · Agente de Atendimento · Phosphorcode
# Renomeie este arquivo para .env e preencha os valores
# ──────────────────────────────────────────────────────────────────────────────

# ── Servidor ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development        # development | production
LOG_LEVEL=info              # trace | debug | info | warn | error

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Define qual provider usar. Se omitido, detecta automaticamente pela chave presente.
# Opções: groq | gemini | anthropic
LLM_PROVIDER=groq

# Groq (grátis — console.groq.com)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile   # padrão

# Google Gemini (grátis — aistudio.google.com)
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash        # padrão

# Anthropic / Claude (pago)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6    # padrão

# ── Evolution API ─────────────────────────────────────────────────────────────
EVOLUTION_API_URL=https://sua-evolution.com    # SEM barra no final
EVOLUTION_API_KEY=sua-api-key-aqui
EVOLUTION_INSTANCE=phosphorcode                # nome da instância configurada

# ── Redis (histórico de conversa) ─────────────────────────────────────────────
# Deixe vazio para usar armazenamento em memória (apenas dev)
REDIS_URL=redis://localhost:6379

# ── Notificações do time ──────────────────────────────────────────────────────

# Webhook genérico (N8N, Make, Zapier) — recebe JSON com type/phone/name/message
NOTIFY_WEBHOOK_URL=

# Slack Incoming Webhook (opcional)
SLACK_WEBHOOK_URL=

# WhatsApp do time para notificações urgentes (formato: 5561999999999)
TEAM_PHONE=

# Grupo do WhatsApp do time COMERCIAL (JID, formato: 123456789012345678@g.us)
TEAM_GROUP_JID=

# ── Agendamento ───────────────────────────────────────────────────────────────
# Link do Calendly, Cal.com ou agenda própria
CALENDAR_LINK=https://phosphorcode.com.br/agendar

# ── Prospecção ativa (cadência D0 / D+3 / D+7) ───────────────────────────────
# Deixe SUPABASE_URL/SUPABASE_SERVICE_KEY vazios para manter a prospecção desativada

# Supabase (controla o estado da cadência de cada lead)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Google Sheets (origem dos leads) — reaproveita GOOGLE_CREDENTIALS_PATH do Calendar
PROSPECT_SHEET_ID=
PROSPECT_SHEET_RANGE=Leads!A2:C   # colunas: telefone, nome, empresa

# Intervalo do tick que verifica leads vencidos (ms) e tamanho do lote por tick
PROSPECT_TICK_MS=900000
PROSPECT_BATCH_SIZE=10

# ── Free Prospecting Intelligence (descoberta de empresas novas, grátis) ─────
# Grupo do WhatsApp "Phosphor Leads" para onde os leads descobertos são enviados
LEADS_GROUP_JID=

# Usado no score (bônus se a empresa for dessa cidade/UF)
PROSPECT_TARGET_CITY=Brasília
PROSPECT_TARGET_UF=DF

# E-mail de contato exigido pela política de uso do Nominatim/Overpass (OpenStreetMap)
PROSPECT_CONTACT_EMAIL=

# Descoberta por CNAE + município (opcional). Sem token, a descoberta cai só pro
# Overpass. Conta grátis em https://brasil.io/ -> gerar token na área de API
BRASILIO_API_TOKEN=

# CNAEs opcionais usados pelo comando "prospecte N empresas de <nicho>" quando
# BRASILIO_API_TOKEN estiver configurado
PROSPECT_INDUSTRIA_CNAE=
PROSPECT_DISTRIBUIDORA_CNAE=
PROSPECT_ATACADO_CNAE=
PROSPECT_SERVICOS_CAMPO_CNAE=
PROSPECT_CLINICAS_CNAE=
PROSPECT_SAUDE_CNAE=
PROSPECT_FRANQUIAS_CNAE=
PROSPECT_AGRO_CNAE=
PROSPECT_ALIMENTOS_CNAE=

# Instagram/LinkedIn e cross-validação de decisor via busca web (opcional). Sem
# chave, essa etapa é pulada. Conta grátis (2000 buscas/mês) em api.search.brave.com
BRAVE_API_KEY=
# Profundidade da busca de contato pessoal do decisor. Aumente para mais qualidade,
# diminua para rodadas maiores/mais rápidas.
PROSPECT_DECISION_CONTACT_PROFILE_QUERIES=2
PROSPECT_DECISION_CONTACT_SNIPPET_QUERIES=2
PROSPECT_DECISION_CONTACT_OFFICIAL_PAGES=4
PROSPECT_DECISION_MENTION_QUERIES=2

# Google Maps via Apify (opcional). Sem token, essa etapa e pulada.
# Actor padrao: compass/crawler-google-places
APIFY_API_TOKEN=
APIFY_GOOGLE_MAPS_ACTOR=compass/crawler-google-places
# APIFY_SEARCH_TERMS=clinica,dentista
# APIFY_SCRAPE_CONTACTS=false
# APIFY_SCRAPE_PLACE_DETAIL_PAGE=false
# Filtro de tamanho (foco em PME/MEI). Só age quando o porte é conhecido (via
# CNPJ enriquecido ou brasil.io); sem dado, o lead segue e fica sinalizado.
# PROSPECT_MAX_PORTE: maior porte aceito — MEI | ME | EPP | DEMAIS. Default EPP
# (aceita MEI/ME/EPP, descarta "Demais"/grande). Use DEMAIS pra desligar o filtro.
PROSPECT_MAX_PORTE=EPP
# Teto de capital social (pega grandes que escapam do porte). Default 10000000 (R$ 10 mi).
PROSPECT_MAX_CAPITAL_SOCIAL=10000000
# Se true, descarta leads sem porte/capital confirmados. Evita empresa grande
# escapando quando vem sem CNPJ por Overpass/Apify. Default true.
PROSPECT_REQUIRE_SIZE_KNOWN=true

# Disparo para leads já descobertos em company_leads (os que aparecem no grupo).
# Só roda de segunda a sexta, dentro da janela BRT abaixo.
COMPANY_OUTREACH_TICK_MS=900000
COMPANY_OUTREACH_BATCH_SIZE=10
COMPANY_OUTREACH_START_HOUR=7
COMPANY_OUTREACH_END_HOUR=18
COMPANY_OUTREACH_INTERVAL_HOURS=6
COMPANY_OUTREACH_MAX_TOUCHES=3
COMPANY_OUTREACH_SUMMARY_LIMIT=12

# ── Segurança ─────────────────────────────────────────────────────────────────

# Chave para proteger os endpoints de admin (POST /admin/resume)
ADMIN_KEY=057ff4461e5c6004db0d3c0c4c3b71defaecee9d4cfbe19e708f396b95411623

# Segredo do webhook da Evolution API (configure o mesmo valor em webhook.set)
WEBHOOK_SECRET=69d76264bcea6a41ad82875a349b8df077cfef321bb7b7c0afd9b9612bdf78aa
